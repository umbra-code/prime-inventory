# Everything here is optional: without these the app works, and the feature
# that needs them reports that it is not available. See the README.

# Vercel Blob store (private) for "Send to another device".
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Postgres database (e.g. Neon) for sync between devices. The table is created on first use.
DATABASE_URL=
