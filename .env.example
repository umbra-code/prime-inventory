# Everything here is optional: without these the app works, and the feature
# that needs them reports that it is not available. See the README.

# Vercel Blob store (private) for "Send to another device".
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Postgres database for sync between devices, e.g. Neon's free plan
# (https://neon.com). Any Postgres works; the table is created on first use.
DATABASE_URL=

# Which client connects to that database. Leave it empty to choose from the
# address: Neon's own driver for *.neon.tech, the standard one for anything
# else. Set it to "neon" or "pg" only to force one.
DATABASE_DRIVER=
